{"id":"yuisync-tm2-f11","locale":"pt-BR","domain":"petshop","intent":"multiple_pets_different_needs","features":["several_recipients","last_minute_addition"],"messages":[{"role":"customer","text":"Preciso comprar comida pra três bichinhos aqui."},{"role":"assistant","text":"Me conta quais são, pra eu separar direitinho."},{"role":"customer","text":"Um cachorro filhote, outro adulto e uma gatinha."},{"role":"assistant","text":"Entendi. Eles usam alguma marca ou ração específica hoje?"},{"role":"customer","text":"O filhote come a de frango pra filhote, o adulto uma de 15 kg. Pra gata pode ser sachê."},{"role":"assistant","text":"Tá. Vou procurar as opções por espécie e fase de vida. Qual marca você usa pros cães?"},{"role":"customer","text":"Depois te falo. Ah, vê se tem um comedouro também."},{"role":"assistant","text":"Claro, incluo o comedouro na consulta."}],"expected_tool":"catalog_search","quality_status":"pending_review","split":"train","adaptation_type":"manual_domain_transfer_from_spoken_roleplay","source":{"dataset":"google-taskmaster-2","subset":"food","source_conversation_id":"dlg-1ae1917c-7c88-4207-9f79-93e7da8f6cd3","source_customer_turn_indices":[1,3,5,7,8,10,12,14,16],"source_git_blob_sha":"1637d76fc83ad7bd20814f8c11b9462c77af1cfc","source_url":"https://github.com/google-research-datasets/Taskmaster/blob/master/TM-2-2020/data/food-ordering.json"},"safety":{"no_operational_facts_without_tools":true,"no_transaction_without_confirmation":true}}
{"id":"yuisync-tm2-f12","locale":"pt-BR","domain":"petshop","intent":"ask_what_is_included","features":["bundle_inclusion_question","add_on_change"],"messages":[{"role":"customer","text":"Queria marcar banho pra minha cachorrinha. A limpeza de ouvido entra junto?"},{"role":"assistant","text":"Depende do pacote da loja. Vou conferir o que está incluído antes de te passar."},{"role":"customer","text":"Tá. E corte de unha?"},{"role":"assistant","text":"Também vou verificar se está incluso ou se é cobrado à parte."},{"role":"customer","text":"Se não vier, me mostra quanto fica com os dois."},{"role":"assistant","text":"Combinado. Te passo a composição certinha assim que consultar os serviços."},{"role":"customer","text":"Fechou."}],"expected_tool":"service_catalog_lookup","quality_status":"pending_review","split":"train","adaptation_type":"manual_domain_transfer_from_spoken_roleplay","source":{"dataset":"google-taskmaster-2","subset":"food","source_conversation_id":"dlg-7d0a150f-d7d9-40a5-aec2-e53c1069511c","source_customer_turn_indices":[1,3,5,7,9,11,13],"source_git_blob_sha":"1637d76fc83ad7bd20814f8c11b9462c77af1cfc","source_url":"https://github.com/google-research-datasets/Taskmaster/blob/master/TM-2-2020/data/food-ordering.json"},"safety":{"no_operational_facts_without_tools":true,"no_transaction_without_confirmation":true}}
