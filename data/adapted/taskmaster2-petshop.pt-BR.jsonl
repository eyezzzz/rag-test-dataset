{"id":"yuisync-tm2-f05","locale":"pt-BR","domain":"petshop","intent":"post_summary_addition","features":["adds_item_after_summary","minimal_acknowledgment"],"messages":[{"role":"customer","text":"Me vê dois sachês de frango e uma areia de gato."},{"role":"assistant","text":"Vou conferir. Você tem alguma marca específica da areia?"},{"role":"customer","text":"Pode ser a que tiver, desde que não seja perfumada."},{"role":"assistant","text":"Tá: dois sachês de frango e uma areia sem perfume. Vou procurar no catálogo."},{"role":"customer","text":"Aham. Ah, e tem pazinha de areia?"},{"role":"assistant","text":"Temos que verificar as opções. Quer que eu inclua uma pazinha na busca?"},{"role":"customer","text":"Pode colocar, sim."}],"expected_tool":"catalog_search","quality_status":"pending_review","split":"train","adaptation_type":"manual_domain_transfer_from_spoken_roleplay","source":{"dataset":"google-taskmaster-2","subset":"food","source_conversation_id":"dlg-ab715c02-b477-4a26-891a-a1abfe638087","source_customer_turn_indices":[0,3,4,5,7,9,11,13,15,17,19],"source_git_blob_sha":"1637d76fc83ad7bd20814f8c11b9462c77af1cfc","source_url":"https://github.com/google-research-datasets/Taskmaster/blob/master/TM-2-2020/data/food-ordering.json"},"safety":{"no_operational_facts_without_tools":true,"no_transaction_without_confirmation":true}}
{"id":"yuisync-tm2-f06","locale":"pt-BR","domain":"petshop","intent":"upsell_declined_gracefully","features":["questions_bundle","declines_upsell"],"messages":[{"role":"customer","text":"Queria uma cama pequena pra gato. Tem?"},{"role":"assistant","text":"Vou ver os modelos. Você prefere aquelas fechadinhas ou abertas?"},{"role":"customer","text":"Abertinha, tipo almofada. Vem com capa lavável?"},{"role":"assistant","text":"Depende do modelo. Vou filtrar pelas que têm capa removível."},{"role":"customer","text":"Tá. E brinquedinho baratinho, tem algum?"},{"role":"assistant","text":"Posso mostrar também. Você quer incluir na pesquisa?"},{"role":"customer","text":"Ah não, deixa só a cama mesmo."},{"role":"assistant","text":"Fechado, vou focar só nas camas."}],"expected_tool":"catalog_search","quality_status":"pending_review","split":"train","adaptation_type":"manual_domain_transfer_from_spoken_roleplay","source":{"dataset":"google-taskmaster-2","subset":"food","source_conversation_id":"dlg-bdc46fbc-2be6-455b-8c90-8230a71e894b","source_customer_turn_indices":[1,2,5,7,9,10,12,14,16,18,20],"source_git_blob_sha":"1637d76fc83ad7bd20814f8c11b9462c77af1cfc","source_url":"https://github.com/google-research-datasets/Taskmaster/blob/master/TM-2-2020/data/food-ordering.json"},"safety":{"no_operational_facts_without_tools":true,"no_transaction_without_confirmation":true}}
{"id":"yuisync-tm2-f07","locale":"pt-BR","domain":"petshop","intent":"specification_change","features":["incomplete_first_message","size_color_preference"],"messages":[{"role":"customer","text":"Tô querendo uma roupinha pro meu cachorro."},{"role":"assistant","text":"Posso procurar. Qual o porte dele?"},{"role":"customer","text":"É pequeno, mas é bem compridinho. Acho que tamanho M."},{"role":"assistant","text":"Entendi. Tem alguma medida dele ou de uma roupa que já serve? Assim evito te indicar tamanho errado."},{"role":"customer","text":"Tenho que medir ainda. Ah, se der, queria azul. Vermelha não."},{"role":"assistant","text":"Combinado. Vou buscar as opções azuis e te passo as medidas de cada modelo."},{"role":"customer","text":"Boa, valeu."}],"expected_tool":"catalog_search","quality_status":"pending_review","split":"train","adaptation_type":"manual_domain_transfer_from_spoken_roleplay","source":{"dataset":"google-taskmaster-2","subset":"food","source_conversation_id":"dlg-44410fc0-80b2-4031-98c7-ed89679e9cf3","source_customer_turn_indices":[1,3,4,6,8,10,13,15,17,19],"source_git_blob_sha":"1637d76fc83ad7bd20814f8c11b9462c77af1cfc","source_url":"https://github.com/google-research-datasets/Taskmaster/blob/master/TM-2-2020/data/food-ordering.json"},"safety":{"no_operational_facts_without_tools":true,"no_transaction_without_confirmation":true}}
