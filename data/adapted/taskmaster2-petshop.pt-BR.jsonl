{"id":"yuisync-tm2-f09","locale":"pt-BR","domain":"petshop","intent":"ambiguous_plural","features":["quantity_disambiguation","informal"],"messages":[{"role":"customer","text":"Oi, queria comprar uns tapetes higiênicos."},{"role":"assistant","text":"Claro. Você procura algum pacote ou quantidade específica?"},{"role":"customer","text":"É só pra um cachorro mesmo. Não sei quantos vêm."},{"role":"assistant","text":"Sem problema. Posso te mostrar os pacotes e a quantidade de unidades de cada um."},{"role":"customer","text":"Queria um que rendesse o mês, mais ou menos."},{"role":"assistant","text":"Entendi. Quantos tapetes você costuma usar por dia?"},{"role":"customer","text":"Uns dois. Às vezes três."}],"expected_tool":"catalog_search","quality_status":"pending_review","split":"train","adaptation_type":"manual_domain_transfer_from_spoken_roleplay","source":{"dataset":"google-taskmaster-2","subset":"food","source_conversation_id":"dlg-c20a14d8-c69b-429d-b5f4-5e03e360bb11","source_customer_turn_indices":[1,3,5,7,9,12,14,16],"source_git_blob_sha":"1637d76fc83ad7bd20814f8c11b9462c77af1cfc","source_url":"https://github.com/google-research-datasets/Taskmaster/blob/master/TM-2-2020/data/food-ordering.json"},"safety":{"no_operational_facts_without_tools":true,"no_transaction_without_confirmation":true}}
